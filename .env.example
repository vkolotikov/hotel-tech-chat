APP_NAME="OnlineChat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://chat.hotel-tech.ai

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hotel_chat
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# Admin Auth
OC_ADMIN_TTL_HOURS=168
OC_ADMIN_ROTATE_HOURS=24

# SaaS Core
SAAS_CORE_ENABLED=true
SAAS_CORE_BASE_URL=https://saas.hotel-tech.ai
SAAS_JWT_SECRET=
SAAS_PRODUCT_KEY=onlinechat

CORS_ALLOWED_ORIGINS=https://chat.hotel-tech.ai

# OpenAI
OC_AI_PROVIDER=openai
OC_OPENAI_API_KEY=
OC_OPENAI_DEFAULT_MODEL=gpt-4o-mini
OC_OPENAI_MAX_TOKENS=160
OC_OPENAI_TEMPERATURE=0.2
OC_OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OC_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Upload limits
OC_UPLOAD_MAX_BYTES=5242880
OC_AVATAR_MAX_BYTES=2097152
